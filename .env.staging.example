# Copy this file to .env.staging (gitignored, same as .env) and fill in real
# values before running `npm run dev:staging`. This is a SEPARATE file from
# .env on purpose — it is the "explicit override" that guarantees a staging
# dev server can never accidentally pick up your regular .env's DATABASE_URL.
#
# Only DATABASE_URL and APP_DB_ENV strictly need to differ from your .env —
# copy the rest of your normal .env values below so the app has everything
# it needs (S3, SendGrid, VAPID, etc. can point at the same non-prod configs
# you already use for local dev).

DATABASE_URL="paste-the-real-staging-connection-string-here"
APP_DB_ENV="staging"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

S3_REGION="ap-southeast-2"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_BUCKET="your-bucket-name"

XAI_API_KEY="your-xai-api-key"

VAPID_PUBLIC_KEY="generate-with-npx-web-push-generate-vapid-keys"
VAPID_PRIVATE_KEY="generate-with-npx-web-push-generate-vapid-keys"
VAPID_SUBJECT="mailto:you@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="same-value-as-VAPID_PUBLIC_KEY"

SENDGRID_API_KEY="your-sendgrid-api-key"
SENDGRID_FROM_EMAIL="you@yourdomain.com"
SENDGRID_REPLY_TEMPLATE_ID="d-your-dynamic-template-id"
SENDGRID_INVITE_TEMPLATE_ID="d-your-dynamic-template-id"

CRON_SECRET="generate-with-openssl-rand-base64-32"
