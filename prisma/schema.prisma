generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentStatus {
  draft
  parsed
  confirmed
}

enum DocumentKind {
  contract
  programme
  // Not a separate upload flow — an existing ContractDocument gets
  // re-tagged to this kind via the same document list (see DocumentPanel's
  // "Mark as quote" action), rather than the AI guessing which uploaded
  // document is the quote. Quote extraction (lib/document-processing.ts's
  // processQuoteDocument) only runs against documents of this kind.
  quote
}

enum ItemStatus {
  draft
  parsed
  confirmed
}

enum ClaimStatus {
  draft
  issued
  responded
}

enum InvoiceStatus {
  draft
  issued
  paid
}

enum EvidenceStatus {
  draft
  confirmed
}

enum EvidenceType {
  upload
  inbound_email
  system_generated
}

// Confirmed unused by any real data before this rename — the old
// new/reviewed/linked InboundEmail flow was never wired to any UI or status
// transition (see lib/inbound-email.ts / the Incoming Emails feature, which
// finally makes this a real, reviewed-by-a-human pipeline).
enum InboundEmailStatus {
  pending_review
  filed
  dismissed
}

enum RiskLevel {
  low
  medium
  high
}

enum VariationStatus {
  draft
  submitted
  approved
  rejected
}

enum VariationItemType {
  variation
  site_instruction
}

enum VariationItemStatus {
  draft
  open
  submitted_for_claim
  complete
}

enum CorrespondenceSource {
  upload
  inbound_email
  response_letter_draft
  external_update
  external_action
}

enum VariationCompletionMode {
  auto
  requires_confirmation
}

// Tracks the most recent deadline-reminder stage already sent for an item, so
// the nightly reminders job (lib/reminders.ts) never re-sends the same stage
// on a later run. Ordered: three_day < one_day < due_today < overdue.
enum ReminderStage {
  three_day
  one_day
  due_today
  overdue
}

enum ContractReviewStatus {
  running
  complete
  failed
}

// Tracks background text-extraction (OCR-if-needed + clause/programme-item
// creation), decoupled from any single request — kicked off right after
// upload rather than blocking on it. "idle" only appears transiently between
// row creation and the background job starting.
enum DocumentProcessingStatus {
  idle
  processing
  ready
  failed
}

enum InsuranceCertificateType {
  public_liability
  contract_works
  professional_indemnity
  vehicle
  other
}

// Separate from ReminderStage (which models 4-stage due-date countdowns) —
// certificate expiry only needs a single "renewal needed soon" heads-up plus
// a distinct "now expired" state if it lapses unrenewed.
enum InsuranceReminderStage {
  six_week
  expired
}

enum DeviationClassification {
  matches_standard
  minor_deviation
  major_deviation
  missing_from_subcontract
  additional_in_subcontract
}

// Fixed, closed set of business-outcome categories a finding can be
// classified into (Contract Review redesign Phase 1) — deliberately a
// Prisma enum, not a free-text preset list like lib/trades.ts, since the AI
// must never invent a category outside this set. "other" is the explicit
// fallback for a genuine non-fit, expected to be rare.
enum FindingCategory {
  payment_cash_flow
  variations
  notices_time_bars
  programme_delay
  liability_indemnity
  insurance
  administration_documentation
  health_safety
  intellectual_property
  final_account
  termination
  // Added after a real staging review showed genuine site-operational
  // obligations (scaffolding, cleaning, hoisting, power/water supply,
  // welfare facilities, sub-letting consent, site access, lighting,
  // marking-out) had nowhere to go and were falling into "other" ~1/3 of
  // the time instead of it being a rare fallback.
  site_facilities_operations
  other
}

// Replaces the old low/medium/high "impact" framing (see
// ContractDeviation.impact, kept only for backward compatibility) with a
// genuine spread rather than everything defaulting to the top tier — see
// the severity-assignment guidance in lib/grok.ts's synthesizeContractReview.
enum FindingSeverity {
  critical
  important
  informational
}

// baseline = compared against the SA-2017 standard form (always true for a
// Main Contractor's first-ever reviewed contract). prior_contract = compared
// against that same Main Contractor's most-recently-reviewed contract on any
// project, once one exists — see ContractReview.comparedAgainstReviewId.
enum ContractReviewComparisonType {
  baseline
  prior_contract
}

// pilot = free access via the shared PILOT_ACCESS_CODE (see app/activate);
// trialing/active = a real Stripe subscription, in its 14-day trial or
// past it; past_due = a Stripe renewal failed; canceled = subscription
// ended; none = brand-new organisation, no access granted yet. Only
// pilot/trialing/active count as "has access" — see Organisation.accessStatus.
enum AccessStatus {
  pilot
  trialing
  active
  past_due
  canceled
  none
}

enum PlanTier {
  starter
  professional
  enterprise
}

// Closed set of H&S document categories (Task 1.1) — defaults to `other` so
// the migration adding this field doesn't break any pre-existing
// SafetyDocument row; new documents are expected to pick a real category.
enum SafetyDocumentType {
  sssp
  hazard_register
  toolbox_talk
  induction
  incident_report
  other
}

// Generic categorisation of what kind of event a Project Diary entry
// (Update) describes — separate from what it's tagged/related to
// (variationItemId / qaRecordId). Offered in the SAME tag dropdown as
// those real object tags (mutually exclusive with both) rather than a
// second control — see Update.category's comment.
enum UpdateCategory {
  general
  progress
  health_safety
  delay
  site_instruction
  variation
  day_works
  delivery
  defect
  other
}

// The six response kinds a request can ask an external recipient for.
// "sign" is deliberately named to match how the business talks about it,
// but nowhere in the app may this be described as a legally binding
// electronic signature — see ExternalAction's own comment and every
// response-UI string for "sign" specifically.
enum ExternalActionType {
  acknowledge
  approve
  sign
  confirm
  reject
  comment
}

enum ExternalActionStatus {
  pending
  responded
  expired
}

// Only meaningful for type: approve, where the recipient picks one or the
// other. Every other type has no such binary choice (acknowledge/confirm/
// sign are a single affirmative action, reject always implies rejected,
// comment carries no choice at all) — stays null for those.
enum ExternalActionChoice {
  approved
  rejected
}

model User {
  id                             String                         @id @default(cuid())
  email                          String                         @unique
  passwordHash                   String
  firstName                      String?
  lastName                       String?
  // Free text — e.g. "Director", "Site Manager", "Quantity Surveyor", not a
  // fixed enum. Optional, same as MainContractorContact.role elsewhere.
  jobTitle                       String?
  // Grants access to /platform-admin (AI usage cost dashboard) — deliberately
  // NOT settable from any UI/API, since this is a single-person,
  // manually-granted capability for the platform owner, not an org-level
  // role. Only ever flipped via a direct database write.
  isPlatformAdmin                Boolean                        @default(false)
  // Set whenever the password changes via the forgot-password reset flow
  // (see lib/password-reset.ts) — compared against a JWT session's `iat` in
  // auth.ts's session callback so any session issued before a reset is
  // treated as logged out on its next request. Not set by the My Settings
  // password-change flow (app/api/account/route.ts) today, only by reset.
  passwordChangedAt              DateTime?
  createdAt                      DateTime                       @default(now())
  memberships                    ProjectMember[]
  organisationMemberships        OrganisationMember[]
  sentInvites                    OrganisationInvite[]
  updates                        Update[]
  pushSubscriptions              PushSubscription[]
  updateReads                    UpdateRead[]
  passwordResetTokens            PasswordResetToken[]
  variationPackages              VariationPackage[]
  sentExternalActions            ExternalAction[]
  cancelledVariationScheduleRuns VariationScheduleRun[]
  automationEnabledProjects      Project[]
  closedVariationItems           VariationItem[]                @relation("VariationItemClosedBy")
  reactivatedVariationItems      VariationItem[]                @relation("VariationItemReactivatedBy")
  createdTasks                   Task[]                         @relation("TaskCreatedBy")
  closedTasks                    Task[]                         @relation("TaskClosedBy")
  closedProjects                 Project[]                      @relation("ProjectClosedBy")
  variationItemClaimAllocations  VariationItemClaimAllocation[]
  recordLifecycleEvents          RecordLifecycleEvent[]
  hoursOnSiteSheets              HoursOnSiteSheet[]
  contractItemProgressEntries    ContractItemProgressEntry[]
}

// One row per requested reset — tokenHash (not the raw token) is what's
// stored, same principle as User.passwordHash; only the raw token ever
// leaves the server, in the emailed link. Hashed with plain SHA-256
// (lib/password-reset.ts), not bcrypt — the token is already
// high-entropy random data (unlike a human-chosen password), so a fast,
// deterministic hash that supports a direct unique-index lookup by hash is
// the right tool here, not bcrypt's slow, salted, non-lookupable hash.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// Same per-email, DB-row-count-in-a-sliding-window throttle as
// PasswordResetToken above (see lib/login-rate-limit.ts) — one row per
// failed login attempt, no relation to User since a rate-limited email
// might not even match a real account. Keyed by raw email string (not
// userId) so an attacker probing a non-existent address is throttled the
// same as one probing a real one.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model Organisation {
  id                      String                    @id @default(cuid())
  name                    String
  // Free text, not an enum — the preset list (lib/trades.ts) is a starting
  // set meant to be easy to extend without a migration; "Other" just stores
  // whatever the user typed. Nullable since existing organisations won't
  // have one set and shouldn't be forced to pick one.
  trade                   String?
  // Data capture only — NOT wired into Contract Review, which unconditionally
  // compares every organisation against SA-2017 regardless of this value.
  // Free text (like trade above), not a Prisma enum, so adding e.g.
  // per-state Australian granularity later doesn't need a migration.
  // Nullable, defaults unset for every existing organisation.
  jurisdiction            String?
  variationCompletionMode VariationCompletionMode   @default(requires_confirmation)
  // Pilot-phase safety cap, not real billing — the sum of this org's
  // AiUsageLog.costUsd within the current calendar month is checked against
  // this before every AI call (see lib/ai-usage.ts's assertWithinSpendCap).
  // Nullable = no cap enforced for this org (the platform owner's escape
  // hatch, e.g. for an org they've manually negotiated with, or to unblock
  // one mid-month from /platform-admin/ai-usage) — distinct from a $0 cap,
  // which would block everything.
  aiMonthlySpendCapUsd    Decimal?                  @default(100) @db.Decimal(10, 2)
  // Billing/access gate (see lib/stripe.ts, app/activate) — an organisation
  // has valid app access iff accessStatus is pilot, trialing, or active;
  // anything else (past_due, canceled, none) redirects to /activate. Set
  // by lib/organisation.ts's requireOrganisationAdmin flow (pilot code) or
  // by the Stripe webhook (app/api/webhooks/stripe/route.ts) — never
  // trust a client redirect alone for subscription state, the webhook is
  // authoritative. Defaults to "none" for brand-new organisations going
  // forward; the migration that introduced this field grandfathered every
  // pre-existing organisation into "pilot" so nobody already using the app
  // was locked out (see prisma/migrations/*_organisation_access_billing).
  accessStatus            AccessStatus              @default(none)
  pilotAccessGrantedAt    DateTime?
  stripeCustomerId        String?                   @unique
  stripeSubscriptionId    String?                   @unique
  planTier                PlanTier?
  trialEndsAt             DateTime?
  createdAt               DateTime                  @default(now())
  // Org-wide branding stamped onto every generated PDF (Hours on Site,
  // Variation Package, Payment Claim) — see lib/pdf-branding.ts. Nullable:
  // no logo means those PDFs render exactly as before, no placeholder box.
  logoStorageKey          String?
  logoContentType         String?
  members                 OrganisationMember[]
  invites                 OrganisationInvite[]
  projects                Project[]
  insuranceCertificates   InsuranceCertificate[]
  mainContractors         MainContractor[]
  inboundEmails           InboundEmail[]
  accessEvents            OrganisationAccessEvent[]
  workers                 Worker[]
}

// One row per accessStatus transition — accessStatus itself (above) is a
// plain overwritten column with no memory of what it changed from or when,
// which makes "when did this company go from trial to active" or "when did
// they cancel" unanswerable today. Written going forward only (see
// lib/organisation-access-log.ts's recordAccessStatusChange, called from
// the 3 places accessStatus is ever actually set: pilot code redemption,
// and the two Stripe webhook paths) — no attempt to reconstruct history
// from before this existed.
model OrganisationAccessEvent {
  id             String        @id @default(cuid())
  organisationId String
  // Null only for an organisation's very first-ever event (nothing to
  // transition from).
  fromStatus     AccessStatus?
  toStatus       AccessStatus
  planTier       PlanTier?
  // Plain string, not an enum — same "extensible preset list" convention as
  // AiUsageLog.feature (lib/ai-usage.ts): a small, code-owned set of tags
  // ("pilot_code", "stripe_checkout", "stripe_subscription_created",
  // "stripe_subscription_updated", "stripe_subscription_deleted") that
  // doesn't need a migration to extend.
  source         String
  createdAt      DateTime      @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@index([organisationId, createdAt])
}

model OrganisationMember {
  id             String   @id @default(cuid())
  organisationId String
  userId         String
  title          String?
  isAdmin        Boolean  @default(false)
  modules        Json     @default("{}")
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organisationId, userId])
}

model OrganisationInvite {
  id              String    @id @default(cuid())
  organisationId  String
  email           String
  title           String?
  isAdmin         Boolean   @default(false)
  modules         Json      @default("{}")
  token           String    @unique @default(cuid())
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id])
  invitedBy    User         @relation(fields: [invitedByUserId], references: [id])
}

model Project {
  id                 String    @id @default(cuid())
  organisationId     String?
  name               String
  code               String?
  status             String    @default("active")
  riskLevel          RiskLevel @default(low)
  nextClaimDate      DateTime?
  invoiceModeEnabled Boolean   @default(false)
  tradeReference     String?
  // Main Contractor's own job/contract number for this project — distinct
  // from `code`, which is Subbie HQ's internal project reference.
  jobNumber          String?
  mainContractorId   String?
  createdAt          DateTime  @default(now())

  // Manual (default): nothing is ever generated/sent without a person
  // clicking Request Approval. automatic_with_approval: the scheduling
  // cron auto-generates the package and warns the team 2 working days
  // before the real deadline, giving a window to review/cancel before it
  // actually sends. fully_automatic: generates and sends on the deadline
  // with no human review step at all — the only automation in this app
  // that can put a real commercial document in front of an external person
  // with nobody having looked at it first. See lib/variation-schedule.ts.
  variationAutomationMode        VariationAutomationMode @default(manual)
  // Whoever last set variationAutomationMode to a non-manual value — the
  // real, accountable human attributed as generatedByUserId/sentByUserId
  // on every package the cron generates/sends for this project, since
  // fully_automatic runs with no human triggering the action in the
  // moment. Deliberately not a fabricated "system" user: this project's
  // owner chose to turn automation on, so the audit trail attributes the
  // automated output to that real decision, not to nobody.
  variationAutomationSetByUserId String?

  // status stays a plain string (not a Prisma enum) deliberately — adding an
  // enum here would need a backfill migration against every existing row's
  // current value; the allowed set ("active" | "completed" | "closed") is
  // enforced in code instead, see lib/project-lifecycle.ts. completedAt
  // marks physical/site work finished — a project can be Completed while
  // still commercially active; closedAt marks the separate, later decision
  // that commercial/admin matters are sufficiently resolved too (see
  // lib/project-lifecycle.ts's closure review). completed must never
  // automatically imply closed.
  completedAt    DateTime?
  closedAt       DateTime?
  closedByUserId String?

  organisation                 Organisation?                @relation(fields: [organisationId], references: [id])
  mainContractor               MainContractor?              @relation(fields: [mainContractorId], references: [id])
  variationAutomationSetByUser User?                        @relation(fields: [variationAutomationSetByUserId], references: [id])
  closedByUser                 User?                        @relation("ProjectClosedBy", fields: [closedByUserId], references: [id])
  members                      ProjectMember[]
  projectContacts              ProjectContact[]
  contractDocuments            ContractDocument[]
  clauses                      Clause[]
  scopeItems                   ScopeItem[]
  programmeItems               ProgrammeItem[]
  monthlyWorkRecords           MonthlyWorkRecord[]
  tasks                        Task[]
  variations                   Variation[]
  paymentClaims                PaymentClaim[]
  invoices                     Invoice[]
  evidence                     Evidence[]
  inboundEmails                InboundEmail[]               @relation("InboundEmailProject")
  suggestedForInboundEmails    InboundEmail[]               @relation("InboundEmailSuggestedProject")
  updates                      Update[]
  safetyDocuments              SafetyDocument[]
  variationItems               VariationItem[]
  correspondence               Correspondence[]
  contractReviews              ContractReview[]
  contractTerms                ContractTerms?
  insuranceDistributions       InsuranceDistribution[]
  contractRequiredCovers       ContractRequiredCover[]
  quote                        ProjectQuote?
  qaRecords                    QARecord[]
  externalActions              ExternalAction[]
  variationScheduleRecipients  VariationScheduleRecipient[]
  variationScheduleRuns        VariationScheduleRun[]
  hoursOnSiteSheets            HoursOnSiteSheet[]
  contractSchedule             ContractSchedule?
  retention                    Retention?
}

enum VariationAutomationMode {
  manual
  automatic_with_approval
  fully_automatic
}

// One project-level distribution list for automated Variation Package
// sends — reused across every scheduled cycle rather than picked per-send,
// since the automation modes above have no human in the loop to choose
// recipients at send time (fully_automatic has no human step at all).
// "to" recipients get their own actionable no-login response link, same as
// a manual Request Approval; "cc" recipients get the same email as a plain
// FYI copy (real email cc, no actionable link) — see
// lib/variation-schedule.ts and lib/email.ts's cc support.
model VariationScheduleRecipient {
  id                      String                 @id @default(cuid())
  projectId               String
  name                    String
  email                   String
  role                    VariationRecipientRole @default(to)
  // Set when picked from the Main Contractor's saved contacts rather than
  // typed as a one-off — same resolve-to-current-email-at-send-time rule
  // as every other saved-contact recipient in this app.
  mainContractorContactId String?
  createdAt               DateTime               @default(now())

  project Project                @relation(fields: [projectId], references: [id])
  contact MainContractorContact? @relation(fields: [mainContractorContactId], references: [id])
}

enum VariationRecipientRole {
  to
  cc
}

// One row per project per calendar month cycle (@@unique below) — the
// scheduling cron's idempotency key, so a job that runs multiple times a
// day (or is retried) never double-warns or double-sends the same month's
// cycle. Also the target of the cancellation mechanism: cancelling this row
// (before it reaches "sent") is the one, unambiguous way to stop an
// upcoming automatic send.
model VariationScheduleRun {
  id                String                     @id @default(cuid())
  projectId         String
  // "YYYY-MM" of the scheduledSendAt this cycle targets — not derived from
  // createdAt, since a warning can be generated in the month before the
  // deadline it's warning about (e.g. warning on 30 Jan for a 2 Feb send).
  cycleMonth        String
  scheduledSendAt   DateTime
  // Null for fully_automatic cycles, which have no separate warning stage.
  warningAt         DateTime?
  status            VariationScheduleRunStatus @default(pending_warning)
  warnedAt          DateTime?
  sentAt            DateTime?
  cancelledAt       DateTime?
  cancelledByUserId String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  project           Project            @relation(fields: [projectId], references: [id])
  cancelledByUser   User?              @relation(fields: [cancelledByUserId], references: [id])
  generatedPackages VariationPackage[]

  @@unique([projectId, cycleMonth])
}

enum VariationScheduleRunStatus {
  pending_warning
  warned
  sent
  cancelled
  // Automatic mode reached the deadline but the project had no eligible
  // open Variation/SI to package — recorded rather than silently skipped,
  // so the cycle still shows up in history instead of looking like a
  // missed run.
  skipped_no_items
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("member")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model ContractDocument {
  id               String                   @id @default(cuid())
  projectId        String
  title            String
  fileName         String
  fileUrl          String
  storageKey       String
  status           DocumentStatus           @default(draft)
  documentType     DocumentKind             @default(contract)
  sourceNotes      String?
  processingStatus DocumentProcessingStatus @default(idle)
  processingError  String?
  uploadedAt       DateTime                 @default(now())

  project                       Project                 @relation(fields: [projectId], references: [id])
  clauses                       Clause[]
  scopeItems                    ScopeItem[]
  programmeItems                ProgrammeItem[]
  reviews                       ContractReview[]
  contractTermsSourced          ContractTerms[]
  correspondenceOutcomes        Correspondence[]
  contractRequiredCoversSourced ContractRequiredCover[]
  quoteSourced                  ProjectQuote[]
}

model Clause {
  id         String     @id @default(cuid())
  projectId  String
  documentId String
  clauseRef  String
  title      String?
  body       String
  riskLevel  RiskLevel  @default(low)
  status     ItemStatus @default(parsed)
  pageNumber Int?
  sourceRef  String?
  createdAt  DateTime   @default(now())

  project    Project          @relation(fields: [projectId], references: [id])
  document   ContractDocument @relation(fields: [documentId], references: [id])
  scopeItems ScopeItem[]
}

model ContractReview {
  id                  String               @id @default(cuid())
  projectId           String
  documentId          String
  standardFormVersion String
  status              ContractReviewStatus @default(running)
  executiveSummary    String?
  overallRiskLevel    RiskLevel?
  // Phase 1.5 — short, specific, contract-derived facts grounding the
  // executive summary (e.g. "6 payment preconditions"), and genuine
  // retained/favourable provisions vs the comparison baseline. Both come
  // from the same synthesis call as executiveSummary/severity/category
  // (no new AI call). positiveFindings is a plain JSON array of
  // {title, context} objects — not a child model, since this is small,
  // display-only content with no need to be relationally queried (see
  // lib/grok.ts's PositiveFindingSchema). Both legitimately empty on
  // reviews from before this shipped, and the UI hides those sections
  // entirely rather than showing an empty state (see
  // components/contract/deviation-report-view.tsx).
  keyObservations     String[]             @default([])
  positiveFindings    Json?
  // Phase 1.75 — category-level synthesis sitting between the executive
  // summary and clause-level findings (see components/contract/deviation-
  // report-view.tsx): for each FindingCategory with at least one finding,
  // a { whatThisMeans, keyRisks, protectYourself } object, keyed by the
  // category string. Plain JSON, not a child model — same reasoning as
  // positiveFindings above (small, display-only, no relational querying
  // need, bounded to the fixed 12-category set). Nullable/legitimately
  // absent on reviews from before this shipped; the UI falls back to the
  // pre-Phase-1.75 flat findings list for those (no broken/empty summary
  // block) rather than requiring a re-run.
  categorySummaries   Json?
  majorDeviationCount Int                  @default(0)
  minorDeviationCount Int                  @default(0)
  errorMessage        String?
  rawModelOutputs     Json?
  createdAt           DateTime             @default(now())
  completedAt         DateTime?

  // What this review's deviations were compared against. "baseline" always
  // for a Main Contractor's first-ever contract; "prior_contract" for every
  // later one, pointing at that MC's previously most-recent review via
  // comparedAgainstReviewId — this chain is what makes the comparison
  // auditable later. isPrimary distinguishes the review actually shown to
  // the user for this document from an internal, always-run baseline
  // "shadow" review (isPrimary: false) that exists purely so the NEXT
  // contract from this Main Contractor can detect newly-introduced SA-2017
  // drift, even though the primary report for THIS document compares
  // against the prior contract instead. See lib/contract-comparison.ts.
  comparedAgainstType     ContractReviewComparisonType @default(baseline)
  comparedAgainstReviewId String?
  isPrimary               Boolean                      @default(true)
  // Count of this Main Contractor's clauses that newly deviate from SA-2017
  // in THIS contract, having matched (or only minorly deviated) in their
  // previous contract — i.e. the MC quietly changed their own template.
  // Only meaningful on isPrimary + comparedAgainstType=prior_contract
  // reviews; the actual flagged clauses live on the sibling shadow review's
  // ContractDeviation rows (isNewBaselineDrift), found via
  // findFirst({ documentId, comparedAgainstType: "baseline", isPrimary: false }).
  newBaselineDriftCount   Int                          @default(0)

  project    Project             @relation(fields: [projectId], references: [id])
  document   ContractDocument    @relation(fields: [documentId], references: [id])
  deviations ContractDeviation[]

  comparedAgainstReview ContractReview?  @relation("ReviewChain", fields: [comparedAgainstReviewId], references: [id])
  chainedReviews        ContractReview[] @relation("ReviewChain")
  responseLetters       Correspondence[]
}

model ContractDeviation {
  id                   String                  @id @default(cuid())
  contractReviewId     String
  topicBucket          String
  baselineClauseRef    String?
  baselineClauseTitle  String?
  subcontractClauseRef String?
  subcontractExcerpt   String?
  classification       DeviationClassification
  // Legacy risk framing — kept (not dropped) purely for schema stability on
  // historical rows; still populated on new reviews (derived from
  // severity) but no longer what the UI displays. See severity below.
  impact               RiskLevel
  // Both nullable: rows from before the Contract Review redesign (Phase 1)
  // predate these fields and will have both null — the results page
  // detects this (see components/contract/deviation-report-view.tsx) and
  // prompts a re-run rather than mixing old/new display formats. Every
  // finding produced going forward always has both set.
  category             FindingCategory?
  severity             FindingSeverity?
  priorityScore        Int
  rationale            String
  recommendation       String?
  sourcePage           Int?
  // Set on a baseline shadow review's deviation rows (see ContractReview
  // comment) when this clause newly deviates from SA-2017 having been fine
  // (or only minor) in the Main Contractor's previous contract — the
  // "quietly changed their own template" case.
  isNewBaselineDrift   Boolean                 @default(false)
  createdAt            DateTime                @default(now())

  contractReview ContractReview @relation(fields: [contractReviewId], references: [id])
}

// Actionable reference data extracted from the governing subcontract (payment
// claim method, notice periods, retention, etc.), surfaced on the Settings
// page. Suggested* fields hold an AI-extracted value until a human confirms
// it (copied into the real field, shadow cleared) — same shadow-value
// pattern as VariationItem.suggestedPercentComplete.
model ContractTerms {
  id                     String  @id @default(cuid())
  projectId              String  @unique
  sourceDocumentId       String?
  sourceContractReviewId String?

  paymentClaimMethod         String?
  paymentClaimDay            Int?
  variationNoticePeriodDays  Int?
  variationNoticeMethod      String?
  retentionPercent           Float?
  defectsLiabilityPeriodDays Int?
  disputeNoticeMethod        String?
  generalNoticeMethod        String?

  suggestedPaymentClaimMethod         String?
  suggestedPaymentClaimDay            Int?
  suggestedVariationNoticePeriodDays  Int?
  suggestedVariationNoticeMethod      String?
  suggestedRetentionPercent           Float?
  suggestedDefectsLiabilityPeriodDays Int?
  suggestedDisputeNoticeMethod        String?
  suggestedGeneralNoticeMethod        String?

  // Day works rate settings. "Normal hours" = Monday-Saturday, 7am-5pm (see
  // the Settings UI help text) — outside that window is Night rate;
  // Sundays and public holidays use the separate rate below.
  materialsMarkupPercent    Float?
  dayWorksRateNormal        Decimal? @db.Decimal(10, 2)
  dayWorksRateNight         Decimal? @db.Decimal(10, 2)
  dayWorksRateSundayHoliday Decimal? @db.Decimal(10, 2)

  // Suggested from the same terms-extraction call as the block above (see
  // extractContractTermsFromClauses) — same suggest-don't-overwrite
  // pattern, confirmed via the generic confirmFields mechanism. The
  // contract's day works rate structure doesn't always map cleanly onto
  // exactly these three buckets (e.g. a single flat rate, or an extra
  // Saturday-specific rate) — suggestedDayWorksRateNotes carries whatever
  // doesn't fit as free text rather than forcing a number into the wrong
  // bucket. Notes has no "confirmed" counterpart of its own (it's
  // read-only context, not a settable value), so it's simply refreshed on
  // every re-run rather than gated by suggestIfUnconfirmed.
  suggestedMaterialsMarkupPercent    Float?
  suggestedDayWorksRateNormal        Decimal? @db.Decimal(10, 2)
  suggestedDayWorksRateNight         Decimal? @db.Decimal(10, 2)
  suggestedDayWorksRateSundayHoliday Decimal? @db.Decimal(10, 2)
  suggestedDayWorksRateNotes         String?

  // Governs when the Variation Package scheduling automation (Project's
  // variationAutomationMode) fires each month — "the contract's own
  // deadline for submitting a variation/SI claim," expressed as either a
  // fixed calendar day-of-month or N working days before month-end. Same
  // suggest-don't-overwrite pattern as every other field above; left null
  // (manual entry required) when extraction can't find a clear number
  // rather than guessing one, since this drives a real external send.
  variationScheduleType  VariationScheduleType?
  variationScheduleValue Int?

  suggestedVariationScheduleType  VariationScheduleType?
  suggestedVariationScheduleValue Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project        Project           @relation(fields: [projectId], references: [id])
  sourceDocument ContractDocument? @relation(fields: [sourceDocumentId], references: [id])
}

enum VariationScheduleType {
  fixed_date
  working_days_before_month_end
}

// Storage-only groundwork for a future Payment Claims comparison (claimed
// amount vs originally quoted scope/value) — no comparison logic exists
// yet, and none is built here. One row per project, replaced wholesale on
// re-extraction (like ContractTerms' suggested* refresh) rather than kept
// as a history, since there's no versioning requirement yet. lineItems is
// a plain JSON array ({description, amount}[]) rather than a child table —
// nothing needs to query/join on individual line items yet; upgrade to a
// relational model if that changes.
model ProjectQuote {
  id               String    @id @default(cuid())
  projectId        String    @unique
  sourceDocumentId String?
  quotedValue      Decimal?  @db.Decimal(12, 2)
  quotedDate       DateTime?
  scopeSummary     String?
  lineItems        Json?
  // Anything clearly-structured and commercially relevant that isn't one
  // of the fields above (payment terms, validity period, exclusions) —
  // free text rather than more bespoke fields, per the task's "any other
  // clearly-structured commercial terms present" without a fixed shape.
  commercialNotes  String?
  extractedAt      DateTime  @default(now())

  project        Project           @relation(fields: [projectId], references: [id])
  sourceDocument ContractDocument? @relation(fields: [sourceDocumentId], references: [id])
}

// Company-level insurance — deliberately NOT project-scoped. A subcontractor
// holds one Public Liability/Contract Works/etc. policy that applies across
// every project they work on, not a separate one per project.
model InsuranceCertificate {
  id                String                   @id @default(cuid())
  organisationId    String
  type              InsuranceCertificateType
  provider          String
  policyNumber      String?
  expiryAt          DateTime?
  fileName          String?
  storageKey        String?
  lastReminderStage InsuranceReminderStage?
  createdAt         DateTime                 @default(now())

  organisation   Organisation                @relation(fields: [organisationId], references: [id])
  distributions  InsuranceDistribution[]
  correspondence Correspondence[]
  covers         InsuranceCertificateCover[]
}

// A single certificate can carry multiple types of cover (e.g. a combined
// policy covering both Public Liability and Contract Works), each with its
// own value — coverType is free text with UI-suggested presets (see
// lib/insurance-cover-types.ts), same light-enum-plus-custom pattern as
// MainContractorContact.role, rather than InsuranceCertificate.type's fixed
// enum (which stays as the certificate's own overall/primary classification).
model InsuranceCertificateCover {
  id                     String   @id @default(cuid())
  insuranceCertificateId String
  coverType              String
  value                  Decimal
  createdAt              DateTime @default(now())

  insuranceCertificate InsuranceCertificate @relation(fields: [insuranceCertificateId], references: [id])
}

// Minimum insurance cover a governing contract states the subcontractor
// must hold, extracted alongside ContractTerms during runContractReview
// (lib/contract-comparison.ts) from the same already-extracted Clause[] —
// one row per cover type found, replaced wholesale each time the project's
// contract is (re)reviewed. Compared live against currently-held
// InsuranceCertificateCover rows at render time (lib/insurance-cover-comparison.ts)
// — never stored as a point-in-time snapshot, so a certificate renewal is
// reflected immediately without needing to re-run the contract review.
model ContractRequiredCover {
  id                     String   @id @default(cuid())
  projectId              String
  coverType              String
  requiredValue          Decimal
  sourceDocumentId       String?
  sourceContractReviewId String?
  createdAt              DateTime @default(now())

  project        Project           @relation(fields: [projectId], references: [id])
  sourceDocument ContractDocument? @relation(fields: [sourceDocumentId], references: [id])
}

// Tracks which projects have received a given certificate — the "paper
// trail" record. The certificate file itself is never copied per-project;
// distributing it just creates this record (+ a referencing Correspondence
// row in that project, see Correspondence.sourceInsuranceCertificateId).
model InsuranceDistribution {
  id                     String   @id @default(cuid())
  insuranceCertificateId String
  projectId              String
  sentAt                 DateTime @default(now())
  note                   String?

  insuranceCertificate InsuranceCertificate @relation(fields: [insuranceCertificateId], references: [id])
  project              Project              @relation(fields: [projectId], references: [id])
}

// Company-level, like InsuranceCertificate — a Main Contractor is a real-world
// company a subcontractor works for, and can span many projects. Never
// inferred from document text (see ContractReview.comparedAgainstType /
// lib/contract-comparison.ts) — always the explicit Project.mainContractorId
// assignment made at project creation or from project Settings.
model MainContractor {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  createdAt      DateTime @default(now())

  organisation Organisation            @relation(fields: [organisationId], references: [id])
  contacts     MainContractorContact[]
  projects     Project[]
  // TODO: surface this Main Contractor's Contract Review comparison history
  // (chain of reviews across all its projects) on the detail page.
}

model MainContractorContact {
  id               String   @id @default(cuid())
  mainContractorId String
  name             String
  email            String?
  phone            String?
  // Free text rather than a locked enum — the UI offers common presets
  // (Health & Safety Officer, Project Manager, Site Manager, Quantity
  // Surveyor, Contracts Manager) plus a custom option, but any role is valid.
  role             String?
  createdAt        DateTime @default(now())

  mainContractor              MainContractor               @relation(fields: [mainContractorId], references: [id])
  projectContacts             ProjectContact[]
  correspondence              Correspondence[]
  updateRecipients            UpdateRecipient[]
  externalActions             ExternalAction[]
  variationScheduleRecipients VariationScheduleRecipient[]
}

// Which of a Main Contractor's contacts are actually active/relevant for a
// specific project — kept as a row (rather than deleted) even when set
// inactive, so historical assignments aren't lost.
model ProjectContact {
  id                      String   @id @default(cuid())
  projectId               String
  mainContractorContactId String
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now())

  project Project               @relation(fields: [projectId], references: [id])
  contact MainContractorContact @relation(fields: [mainContractorContactId], references: [id])

  @@unique([projectId, mainContractorContactId])
}

model ScopeItem {
  id               String     @id @default(cuid())
  projectId        String
  title            String
  description      String?
  status           ItemStatus @default(parsed)
  confidence       Float?     @default(0)
  ambiguityFlag    Boolean    @default(false)
  sourceDocumentId String?
  sourceClauseId   String?
  sourcePage       Int?
  createdAt        DateTime   @default(now())

  project        Project              @relation(fields: [projectId], references: [id])
  sourceDocument ContractDocument?    @relation(fields: [sourceDocumentId], references: [id])
  sourceClause   Clause?              @relation(fields: [sourceClauseId], references: [id])
  programmeLinks ScopeProgrammeLink[]
  evidenceLinks  EvidenceScopeItem[]
}

model ProgrammeItem {
  id               String     @id @default(cuid())
  projectId        String
  title            String
  description      String?
  startDate        DateTime?
  endDate          DateTime?
  status           ItemStatus @default(parsed)
  confidence       Float?     @default(0)
  sourceDocumentId String?
  sourcePage       Int?
  completedAt      DateTime?
  createdAt        DateTime   @default(now())

  project        Project                 @relation(fields: [projectId], references: [id])
  sourceDocument ContractDocument?       @relation(fields: [sourceDocumentId], references: [id])
  scopeLinks     ScopeProgrammeLink[]
  evidenceLinks  EvidenceProgrammeItem[]
}

model ScopeProgrammeLink {
  id              String @id @default(cuid())
  scopeItemId     String
  programmeItemId String

  scopeItem     ScopeItem     @relation(fields: [scopeItemId], references: [id])
  programmeItem ProgrammeItem @relation(fields: [programmeItemId], references: [id])

  @@unique([scopeItemId, programmeItemId])
}

model MonthlyWorkRecord {
  id             String     @id @default(cuid())
  projectId      String
  periodStart    DateTime
  periodEnd      DateTime
  completedValue Decimal    @default(0)
  notes          String?
  status         ItemStatus @default(draft)
  createdAt      DateTime   @default(now())

  project Project @relation(fields: [projectId], references: [id])
}

model Variation {
  id          String          @id @default(cuid())
  projectId   String
  title       String
  description String?
  amount      Decimal         @default(0)
  status      VariationStatus @default(draft)
  sourceRef   String?
  createdAt   DateTime        @default(now())

  project Project @relation(fields: [projectId], references: [id])
}

// The monthly commercial container for a claim — not merely a generated
// document. claimedAmount is enforced (in application code, see
// lib/payment-claim.ts) as the computed total of contractWorksAmount +
// otherAmount + the sum of this claim's VariationItemClaimAllocation rows,
// so the container's total is never typed separately from what's actually
// in it. Its supporting evidence links to the REAL, live evidence chain
// (VariationPackage/Correspondence/ExternalAction/QARecord/Update) via
// ClaimEvidenceLink below — deliberately NOT the dormant
// EvidencePaymentClaim/Evidence models, which predate VariationPackage and
// were never wired to any real UI (kept below, untouched, unreferenced by
// any new code).
model PaymentClaim {
  id                  String      @id @default(cuid())
  projectId           String
  claimNumber         Int
  referenceDate       DateTime
  periodStart         DateTime
  periodEnd           DateTime
  status              ClaimStatus @default(draft)
  claimedAmount       Decimal     @default(0)
  statutoryWording    String
  serviceDate         DateTime?
  pdfUrl              String?
  storageKey          String?
  createdAt           DateTime    @default(now())
  // "YYYY-MM" — the first-class monthly identity of this claim, same
  // string convention as VariationScheduleRun.cycleMonth. Mandatory going
  // forward; backfilled from periodStart for the 3-step NOT NULL migration
  // (see this migration's SQL) even though 0 real rows exist today.
  claimMonth          String
  // Claim lines that aren't tied to any VariationItem — the base contract
  // works progress claim, and a free-text-described "other" catch-all.
  // Variation lines live in `allocations` below instead.
  contractWorksAmount Decimal     @default(0)
  otherAmount         Decimal     @default(0)
  otherDescription    String?

  project            Project                        @relation(fields: [projectId], references: [id])
  // Legacy, pre-dates any real UI — this model was scaffolded before
  // VariationPackage/Correspondence/ExternalAction became the actual,
  // working evidence chain (see claimEvidenceLinks below, which links to
  // THAT chain instead). Left in place, unused, per "never delete".
  evidenceLinks      EvidencePaymentClaim[]
  allocations        VariationItemClaimAllocation[]
  claimEvidenceLinks ClaimEvidenceLink[]

  @@unique([projectId, claimNumber])
}

// One row per project — the retention side of Payment Claims (Appendix
// B1's "Less retention" line, tracked forward to actual release rather
// than just deducted). Deliberately does NOT store a running withheld
// total: that figure is always computed live as
// Σ(PaymentClaim.claimedAmount) × ContractTerms.retentionPercent/100 (see
// lib/retention.ts) — the real PaymentClaim rows already ARE the source of
// truth for what's been claimed, so duplicating a total here would just be
// another number that can drift out of sync with them. Two tranches
// modelled explicitly (not one combined release) because that's how
// retention actually gets released in practice — commonly half at
// Practical Completion, the remainder at the end of the Defects Liability
// Period — and a Main Contractor routinely only releases the first half
// on time, leaving the second outstanding for months; collapsing that
// into one date/amount would hide exactly the "did they actually release
// it" tracking this feature exists for.
//
// Known, deliberately deferred gap: no retention CAP is modelled (some
// contracts stop accruing retention once it hits a ceiling, e.g. 5% up to
// a max of 2.5% of contract value) — retention keeps accruing at
// ContractTerms.retentionPercent indefinitely. Flagged plainly rather than
// guessed at; add if a real contract needs it.
model Retention {
  id        String @id @default(cuid())
  projectId String @unique

  // Practical Completion, for retention purposes specifically — falls
  // back to Project.completedAt (which already tracks "site work
  // finished") when null, since the two are usually the same date; this
  // override exists only for the real but less common case where a
  // certified PC date differs from Subbie HQ's own Project.completedAt.
  practicalCompletionDateOverride DateTime?

  // Tranche 1 — released at Practical Completion.
  tranche1ExpectedDate      DateTime?
  tranche1Percent           Float?
  tranche1ReleasedAmount    Decimal?       @db.Decimal(12, 2)
  tranche1ReleasedAt        DateTime?
  tranche1LastReminderStage ReminderStage?

  // Tranche 2 — released at the end of the Defects Liability Period.
  // tranche2ExpectedDate defaults (in application code, not the database)
  // to tranche1ExpectedDate + ContractTerms.defectsLiabilityPeriodDays,
  // but is stored and editable here since either date can genuinely slip
  // independently of the contract's stated terms.
  tranche2ExpectedDate      DateTime?
  tranche2Percent           Float?
  tranche2ReleasedAmount    Decimal?       @db.Decimal(12, 2)
  tranche2ReleasedAt        DateTime?
  tranche2LastReminderStage ReminderStage?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])
}

// One row per Variation claimed, in one specific month's claim — the
// Variation's own creation month (variationCreatedAt) never moves because
// of this; this is purely "how much of it is in THIS claim." Multiple rows
// across different PaymentClaims for the same VariationItem is exactly how
// a Variation gets claimed over several months. Day Works is never
// separately "claimed" — it's evidence supporting its parent
// VariationItem's allocation (already true via VariationPackage), so no
// separate Day-Works-claim model exists.
model VariationItemClaimAllocation {
  id              String   @id @default(cuid())
  variationItemId String
  paymentClaimId  String
  amount          Decimal  @db.Decimal(12, 2)
  createdByUserId String
  createdAt       DateTime @default(now())

  variationItem VariationItem @relation(fields: [variationItemId], references: [id])
  paymentClaim  PaymentClaim  @relation(fields: [paymentClaimId], references: [id])
  createdByUser User          @relation(fields: [createdByUserId], references: [id])

  @@unique([variationItemId, paymentClaimId])
}

// Polymorphic by design (evidenceId is a plain string, resolved against
// whichever table evidenceType names, in application code — no cross-table
// FK is possible in one column) — links to the REAL, working evidence chain,
// not the dormant Evidence model above.
enum ClaimEvidenceType {
  variation_package
  correspondence
  external_action
  qa_record
  update
}

model ClaimEvidenceLink {
  id             String            @id @default(cuid())
  paymentClaimId String
  evidenceType   ClaimEvidenceType
  evidenceId     String
  createdAt      DateTime          @default(now())

  paymentClaim PaymentClaim @relation(fields: [paymentClaimId], references: [id])

  @@unique([paymentClaimId, evidenceType, evidenceId])
}

// ============================================================
// Contract Schedule of Values — the "Original Subcontract Sum" side of a
// Payment Claim (Appendix B2's equivalent), extracted from the subbie's own
// priced quote. Deliberately separate from ProjectQuote above: ProjectQuote
// is a lightweight one-shot text-extracted summary (quotedValue, a loose
// lineItems Json blob) shown on the Contract tab, with no components,
// phases, or rental tracking — kept exactly as-is, untouched, for that
// purpose. This is the real, structured schedule Payment Claims needs;
// building a second thing rather than reshaping ProjectQuote follows this
// codebase's established pattern of leaving a superseded simpler model
// alone rather than migrating it (see ClaimEvidenceLink's own comment re:
// the dormant Evidence model).
model ContractSchedule {
  id                      String     @id @default(cuid())
  projectId               String     @unique
  // The uploaded quote this was extracted from — nullable, since a schedule
  // can equally be built entirely by hand with no source document at all.
  sourceFileName          String?
  sourceStorageKey        String?
  sourceContentType       String?
  // draft = AI-extracted, not yet reviewed; confirmed = a human has checked
  // it over. A hand-built schedule (no extraction) starts confirmed.
  status                  ItemStatus @default(confirmed)
  // The default Erect/Dismantle phase split offered when adding a new
  // erect-and-dismantle-shaped component (e.g. 70/30, from the quote's own
  // "Breakdown of Charges" note) — a starting point, not enforced; any
  // individual component's phases can differ from this default.
  defaultErectPercent     Float?
  defaultDismantlePercent Float?
  extractedAt             DateTime?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  project Project        @relation(fields: [projectId], references: [id])
  items   ContractItem[]
}

model ContractItem {
  id           String   @id @default(cuid())
  scheduleId   String
  // Optional grouping heading, matching how real quotes are laid out (e.g.
  // "NORTH ELEVATION") — purely organisational, not used in any calculation.
  sectionLabel String?
  description  String
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  schedule   ContractSchedule        @relation(fields: [scheduleId], references: [id])
  components ContractItemComponent[]
}

// fixed = any lump-sum priced component (Supply, Install, Erect, Dismantle,
// Remove, Transport, Engineer's Fee, or any combination — see phases below
// for how a single component can still represent "supply and install" or
// "supply, install, dismantle and remove" as one priced amount broken into
// claimable portions). weekly_hire = an ongoing rental charged for as long
// as (and to whatever % of) the item is actually on site — see
// ContractItemProgressEntry for how that % is tracked over time.
enum ContractItemComponentKind {
  fixed
  weekly_hire
}

model ContractItemComponent {
  id                  String                    @id @default(cuid())
  contractItemId      String
  kind                ContractItemComponentKind
  // A short label for this component within its item (e.g. "Erect &
  // Dismantle", "Transport", "Weekly Hire") — free text, not an enum,
  // deliberately: the whole point of this model is that different trades'
  // quotes carve up a priced item differently, and forcing a fixed set of
  // labels would break the very next trade whose quote doesn't match
  // scaffolding's shape.
  label               String
  // fixed only — the total priced amount, split across phases below.
  amount              Decimal?                  @db.Decimal(12, 2)
  // weekly_hire only — the rate actually charged per week while on hire.
  weeklyRate          Decimal?                  @db.Decimal(12, 2)
  // weekly_hire only, informational — the quote's OWN assumed duration,
  // used only to reconstruct what this component's originally quoted total
  // contract value was (Duration × Weekly Hire, as printed on the quote).
  // Real claiming never uses this — it always follows the real, dated %-
  // on-hire history in ContractItemProgressEntry instead, which is free to
  // run longer or shorter than what was originally quoted.
  quotedDurationWeeks Float?
  sortOrder           Int                       @default(0)
  createdAt           DateTime                  @default(now())

  contractItem    ContractItem                 @relation(fields: [contractItemId], references: [id])
  phases          ContractItemComponentPhase[]
  // weekly_hire progress attaches directly here (no phase concept for an
  // ongoing rental) — see ContractItemProgressEntry.componentId.
  progressEntries ContractItemProgressEntry[]
}

// One or more phases per FIXED component — sharePercent across a
// component's phases should sum to 100. A simple "Supply only" component
// has exactly one phase at 100%; the quote's "Erect & Dismantle" becomes
// two (Erect 70%, Dismantle 30%, from the schedule's default); a trade
// quoting "Supply, Install, Dismantle and Remove" as one lump sum gets four.
// Each phase tracks its own % complete history independently — this is
// what lets a portion of a fixed labour cost be claimed at Dismantle even
// though Erect was claimed (and paid) months earlier.
model ContractItemComponentPhase {
  id           String @id @default(cuid())
  componentId  String
  label        String
  sharePercent Float
  sortOrder    Int    @default(0)

  component       ContractItemComponent       @relation(fields: [componentId], references: [id])
  progressEntries ContractItemProgressEntry[]
}

enum ContractItemProgressSource {
  manual
  project_diary
}

// The one dated-checkpoint mechanism behind BOTH kinds of % this feature
// tracks — a fixed component phase's % complete, and a weekly_hire
// component's % of the item currently on hire. On any given day, the
// applicable % is whichever checkpoint has the latest effectiveDate on or
// before that day (0% before the first checkpoint ever recorded) — see
// lib/contract-schedule.ts for the read-side logic this enables: a fixed
// phase is read as "the latest % as of the claim date" (point-in-time),
// while a weekly_hire component is read as a day-by-day weighted sum across
// the claim period (continuous accrual) — same underlying checkpoint
// history, two different aggregations, because the two kinds of value
// accrue differently in real life.
//
// Exactly one of phaseId/componentId is set — a fixed phase's progress, or
// a weekly_hire component's progress, never both on the same row. Enforced
// in application code (see lib/contract-schedule.ts), the same way
// PaymentClaim's own claimedAmount invariant is — no DB-level CHECK
// constraint, consistent with this codebase's existing convention.
model ContractItemProgressEntry {
  id                   String                     @id @default(cuid())
  phaseId              String?
  componentId          String?
  effectiveDate        DateTime
  percent              Float
  source               ContractItemProgressSource @default(manual)
  // Set only when source = project_diary — which Update contributed this
  // checkpoint (Phase 3 of this feature; the column exists now so Phase 1's
  // schema doesn't need a follow-up migration once that's wired).
  projectDiaryUpdateId String?
  note                 String?
  createdByUserId      String?
  createdAt            DateTime                   @default(now())

  phase         ContractItemComponentPhase? @relation(fields: [phaseId], references: [id])
  component     ContractItemComponent?      @relation(fields: [componentId], references: [id])
  sourceUpdate  Update?                     @relation(fields: [projectDiaryUpdateId], references: [id])
  createdByUser User?                       @relation(fields: [createdByUserId], references: [id])

  @@index([phaseId, effectiveDate])
  @@index([componentId, effectiveDate])
}

model Invoice {
  id            String        @id @default(cuid())
  projectId     String
  invoiceNumber Int
  referenceDate DateTime
  status        InvoiceStatus @default(draft)
  amount        Decimal       @default(0)
  pdfUrl        String?
  storageKey    String?
  createdAt     DateTime      @default(now())

  project Project @relation(fields: [projectId], references: [id])

  @@unique([projectId, invoiceNumber])
}

model Evidence {
  id             String         @id @default(cuid())
  projectId      String
  type           EvidenceType
  status         EvidenceStatus @default(draft)
  title          String?
  fileName       String
  fileUrl        String
  storageKey     String
  sourceRef      String?
  uploadedAt     DateTime       @default(now())
  inboundEmailId String?

  project           Project                 @relation(fields: [projectId], references: [id])
  inboundEmail      InboundEmail?           @relation(fields: [inboundEmailId], references: [id])
  scopeLinks        EvidenceScopeItem[]
  programmeLinks    EvidenceProgrammeItem[]
  paymentClaimLinks EvidencePaymentClaim[]
}

// Lands via the SendGrid Inbound Parse webhook (lib/inbound-email.ts),
// addressed to inbox+<organisationId>@<inbound domain> — organisationId is
// always known immediately (parsed from the address), but projectId is not:
// nothing is pre-known from which address an email arrived at, so it starts
// null and is only ever set once a human confirms it in the Incoming Emails
// review queue (see app/(app)/incoming-emails/page.tsx). suggested* fields
// are Grok's best guess, shown for review — never auto-applied.
model InboundEmail {
  id             String             @id @default(cuid())
  organisationId String
  projectId      String?
  sender         String
  ccAddresses    String[]           @default([])
  subject        String
  body           String
  status         InboundEmailStatus @default(pending_review)
  receivedAt     DateTime           @default(now())

  // AI suggestions — advisory only, a human confirms or overrides every one
  // of these before anything gets filed (see Incoming Emails review dialog).
  suggestedProjectId         String?
  suggestedProjectConfidence Float?
  // Free text, not a locked enum — see lib/inbound-email-types.ts for the
  // common presets offered in the UI; any custom string is also valid.
  suggestedType              String?
  suggestedVariationItemId   String?
  aiSummary                  String?
  // Set when classifyAndSuggest (lib/inbound-email.ts) throws — a short,
  // human-readable reason, surfaced in the Incoming Emails UI so a failed
  // classification is visibly distinct from "AI genuinely found nothing"
  // rather than silently leaving the row blank either way. Cleared on a
  // successful (re)classification.
  classificationError        String?

  reviewedByUserId String?
  reviewedAt       DateTime?
  dismissedAt      DateTime?

  organisation           Organisation             @relation(fields: [organisationId], references: [id])
  project                Project?                 @relation("InboundEmailProject", fields: [projectId], references: [id])
  suggestedProject       Project?                 @relation("InboundEmailSuggestedProject", fields: [suggestedProjectId], references: [id])
  suggestedVariationItem VariationItem?           @relation("InboundEmailSuggestedVariationItem", fields: [suggestedVariationItemId], references: [id])
  attachments            InboundEmailAttachment[]
  evidence               Evidence[]
  correspondence         Correspondence?
}

model InboundEmailAttachment {
  id             String   @id @default(cuid())
  inboundEmailId String
  fileName       String
  storageKey     String
  contentType    String
  createdAt      DateTime @default(now())

  inboundEmail InboundEmail @relation(fields: [inboundEmailId], references: [id])
}

model EvidenceScopeItem {
  id          String @id @default(cuid())
  evidenceId  String
  scopeItemId String

  evidence  Evidence  @relation(fields: [evidenceId], references: [id])
  scopeItem ScopeItem @relation(fields: [scopeItemId], references: [id])

  @@unique([evidenceId, scopeItemId])
}

model EvidenceProgrammeItem {
  id              String @id @default(cuid())
  evidenceId      String
  programmeItemId String

  evidence      Evidence      @relation(fields: [evidenceId], references: [id])
  programmeItem ProgrammeItem @relation(fields: [programmeItemId], references: [id])

  @@unique([evidenceId, programmeItemId])
}

model EvidencePaymentClaim {
  id             String @id @default(cuid())
  evidenceId     String
  paymentClaimId String

  evidence     Evidence     @relation(fields: [evidenceId], references: [id])
  paymentClaim PaymentClaim @relation(fields: [paymentClaimId], references: [id])

  @@unique([evidenceId, paymentClaimId])
}

model Update {
  id              String          @id @default(cuid())
  projectId       String
  authorId        String
  parentId        String?
  variationItemId String?
  // Mutually exclusive with variationItemId — an Update is tagged to EITHER
  // a Variation/SI directly OR a QA record (which itself may separately be
  // project-level or item-linked, see QARecord). Set via the same tag
  // dropdown ("Assign QA" option) — selecting it copies every attachment on
  // this Update into a new QARecord (see the qa-records POST route's
  // source: { type: "update" } branch) rather than moving anything.
  qaRecordId      String?
  // Mutually exclusive with BOTH variationItemId and qaRecordId — one
  // combined tag dropdown offers real object tags (SI/Variation, QA) grouped
  // alongside these generic category labels; picking any one of the three
  // clears the other two (enforced in the PATCH route, not just client-side).
  // Nullable/no default — "Not Assigned" until a user picks one explicitly.
  category        UpdateCategory?
  percentComplete Float?
  body            String
  createdAt       DateTime        @default(now())

  // External updates are a one-way notification sent out by email (via
  // SendGrid, see lib/email.ts) rather than an internal, reply-supported
  // thread entry — `body` still holds the author's original rough text
  // (typed or Whisper-transcribed), while externalSubject/externalBody hold
  // the final, human-reviewed content that was actually emailed, so there's
  // an exact record of what went out. externalSentAt is set once the send
  // succeeds; a row with isExternal true but externalSentAt null shouldn't
  // normally persist (the update is only created once the user hits Send —
  // see app/api/projects/[projectId]/updates/route.ts), but is left
  // nullable rather than required in case a send needs retrying later.
  isExternal      Boolean   @default(false)
  externalSubject String?
  externalBody    String?
  externalSentAt  DateTime?

  project                     Project                     @relation(fields: [projectId], references: [id])
  author                      User                        @relation(fields: [authorId], references: [id])
  parent                      Update?                     @relation("UpdateReplies", fields: [parentId], references: [id])
  replies                     Update[]                    @relation("UpdateReplies")
  variationItem               VariationItem?              @relation(fields: [variationItemId], references: [id])
  qaRecord                    QARecord?                   @relation(fields: [qaRecordId], references: [id])
  attachments                 UpdateAttachment[]
  recipients                  UpdateRecipient[]
  correspondence              Correspondence[]
  reads                       UpdateRead[]
  contractItemProgressEntries ContractItemProgressEntry[]
}

// Per-user read state for an Update — private to each user (one user
// marking an Update read has no effect on whether it still shows unread for
// anyone else with access to the same project). Pre-existing Updates have
// no row here for anyone, so they correctly default to "unread" on rollout.
model UpdateRead {
  id       String   @id @default(cuid())
  userId   String
  updateId String
  readAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  update Update @relation(fields: [updateId], references: [id])

  @@unique([userId, updateId])
}

// Who an external Update was actually sent to — a mix of saved Main
// Contractor contacts and one-off typed email addresses is expected on the
// same update, hence a child row per recipient rather than a flat field.
// `email` is always populated (copied from the contact at send time for
// contact-based recipients) so the record of who received it doesn't
// silently change if the contact's email is edited later.
model UpdateRecipient {
  id                      String   @id @default(cuid())
  updateId                String
  mainContractorContactId String?
  email                   String
  createdAt               DateTime @default(now())

  update  Update                 @relation(fields: [updateId], references: [id])
  contact MainContractorContact? @relation(fields: [mainContractorContactId], references: [id])
}

model VariationItem {
  id                       String              @id @default(cuid())
  projectId                String
  type                     VariationItemType
  reference                String
  title                    String
  description              String?
  status                   VariationItemStatus @default(open)
  percentComplete          Float?
  // Set when the org's completion mode is "requires_confirmation" and someone
  // tags an Update with a % complete — sits here until an Admin/PM confirms it,
  // at which point it's copied into percentComplete and cleared.
  suggestedPercentComplete Float?
  notifiedAt               DateTime?
  dueAt                    DateTime?
  fileName                 String?
  storageKey               String?
  quoteFileName            String?
  quoteStorageKey          String?
  // Last deadline-reminder stage sent for this item's dueAt — see ReminderStage.
  lastReminderStage        ReminderStage?
  createdAt                DateTime            @default(now())

  // A Site Instruction and a Variation are no longer mutually exclusive on
  // one row — `type` still tracks the item's ORIGIN (how it was first
  // created) and never changes, while variationCreatedAt marks whether this
  // record ALSO now carries a Variation identity. Set immediately at
  // creation for type: "variation" rows (they inherently have one), or
  // later via "Create Variation" for a type: "site_instruction" row. Treat
  // `variationCreatedAt != null` as the "hasVariation" check throughout —
  // deliberately a timestamp rather than a plain boolean, since a boolean
  // can't also answer "since when".
  variationCreatedAt DateTime?
  // Manually-entered $ value for the Variation identity — meaningful only
  // once variationCreatedAt is set. No auto-calculation from Day Works
  // Sheet hours (deliberately out of scope, kept manual for now).
  variationValue     Decimal?
  // Free text — who on site/the Main Contractor gave the instruction (e.g.
  // "J. Smith, Site Manager"), shown on a generated Variation Package.
  // Nothing upstream captures this structurally (no linked contact/user),
  // so it's a plain optional field the user fills in themselves, same
  // convention as generalNoticeMethod/disputeNoticeMethod on ContractTerms.
  instructedByName   String?

  // Closed/reactivated is a dimension ORTHOGONAL to the completion axis
  // above (status/percentComplete) — a Site Instruction and the Variation
  // it becomes are the SAME row (see the comment above on type/
  // variationCreatedAt), so one closed/reactivated pair here correctly
  // covers both identities rather than needing two parallel state
  // machines. `complete` (status) must never automatically imply closed —
  // these fields only ever change via an explicit close/reactivate action
  // (lib/variation-item-lifecycle.ts). closedAt null = active, in every
  // normal list/dashboard; set = excluded from those, but every relation
  // and the row itself remain fully queryable by id — closing never
  // detaches or hides data, only changes which default queries include it.
  // These are CURRENT-STATE fields only (fast "is this active" checks
  // without a join) — the full history of every close/reactivate, with
  // context, lives in RecordLifecycleEvent below and is never overwritten
  // by a later transition.
  closedAt            DateTime?
  closedByUserId      String?
  reactivatedAt       DateTime?
  reactivatedByUserId String?

  project                   Project                        @relation(fields: [projectId], references: [id])
  updates                   Update[]
  dayWorksSheets            DayWorksSheet[]
  // Direct, sheet-independent relations (Labour, Plant & Material AI
  // Extraction feature) — the primary way materials/plant/labour records
  // attach to an item going forward; see DayWorksMaterial/DayWorksPlant/
  // DayWorksSheetRecord's own comments.
  materials                 DayWorksMaterial[]
  plant                     DayWorksPlant[]
  sheetRecords              DayWorksSheetRecord[]
  photos                    VariationPhoto[]
  correspondence            Correspondence[]
  packages                  VariationPackage[]
  // TODO: when preparing this item for submission (submitted_for_claim), surface
  // linked `correspondence` rows (including filed inbound emails) as supporting
  // evidence for the reviewer — not built yet, see Incoming Emails Task 4.2.
  suggestedForInboundEmails InboundEmail[]                 @relation("InboundEmailSuggestedVariationItem")
  qaRecords                 QARecord[]
  externalActions           ExternalAction[]
  tasks                     Task[]
  claimAllocations          VariationItemClaimAllocation[]
  closedByUser              User?                          @relation("VariationItemClosedBy", fields: [closedByUserId], references: [id])
  reactivatedByUser         User?                          @relation("VariationItemReactivatedBy", fields: [reactivatedByUserId], references: [id])
  hoursOnSiteSheets         HoursOnSiteSheet[]
}

// A general-purpose, user-created work item — distinct from ProgrammeItem
// (an AI-parsed contract-programme MILESTONE, whose draft/parsed/confirmed
// status tracks whether the extraction was confirmed accurate, not whether
// work is done). Completed and Closed are deliberately separate states: a
// Task can sit Completed and stay visible/reachable until someone
// explicitly Closes it — closure is never automatic just because status
// reaches completed. No attachment mechanism of its own yet, deliberately
// deferred rather than built bespoke — this codebase's convention for
// attachments is a dedicated per-entity table (UpdateAttachment,
// QARecordAttachment), so a future TaskAttachment would follow that same
// pattern; nothing here blocks adding it later.
enum TaskStatus {
  open
  in_progress
  completed
  closed
}

model Task {
  id              String     @id @default(cuid())
  projectId       String
  title           String
  description     String?
  status          TaskStatus @default(open)
  // Optional — a Task doesn't have to relate to an SI/Variation at all.
  variationItemId String?
  dueAt           DateTime?
  completedAt     DateTime?
  closedAt        DateTime?
  closedByUserId  String?
  createdByUserId String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  project       Project        @relation(fields: [projectId], references: [id])
  variationItem VariationItem? @relation(fields: [variationItemId], references: [id])
  createdByUser User           @relation("TaskCreatedBy", fields: [createdByUserId], references: [id])
  closedByUser  User?          @relation("TaskClosedBy", fields: [closedByUserId], references: [id])
}

// One shared audit log for every close/reactivate/complete event across
// VariationItem/Task/Project — the same pattern this codebase already uses
// for OrganisationAccessEvent/recordAccessStatusChange (lib/organisation-
// access-log.ts), mirrored here rather than duplicated. Deliberately a real
// audit trail, not just a status flag: previousState/newState capture the
// actual transition, and note carries either a user-supplied reason or an
// auto-composed summary of whatever closure-review warnings were
// overridden — this is what lets someone reconstruct "why was this closed,
// why was it reopened three weeks later" from history alone. Deliberately
// NOT a per-entity-type table (one RecordLifecycleEvent model, not three).
enum RecordLifecycleEntityType {
  variation_item
  task
  project
}

enum RecordLifecycleEventType {
  closed
  reactivated
  completed
}

model RecordLifecycleEvent {
  id            String                    @id @default(cuid())
  entityType    RecordLifecycleEntityType
  entityId      String
  eventType     RecordLifecycleEventType
  userId        String
  // Plain strings, not FKs to any status enum — this log spans 3 entity
  // types with 3 different state vocabularies (VariationItem: active/
  // closed; Task: open/in_progress/completed/closed; Project: active/
  // completed/closed).
  previousState String?
  newState      String?
  note          String?
  createdAt     DateTime                  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId, createdAt])
}

// fileName/storageKey are the original feature — an uploaded photo/scan of
// the physical day works sheet(s). contentType is additive (nullable —
// older rows uploaded before this field existed won't have it) and drives
// which OCR path extraction uses (PDF page-render-and-OCR vs direct image
// OCR — see lib/pdf-text-extraction.ts). materials/plant/sheetRecords
// below are all the HISTORICAL back-reference only — rows created via AI
// extraction from this file (or, for materials/plant, a user's
// deliberate choice to still log against a specific sheet) retain this
// link for traceability, but the primary, current relation for all three
// is VariationItem.materials/plant/sheetRecords directly (see
// DayWorksMaterial/DayWorksPlant/DayWorksSheetRecord), independent of
// any sheet. One uploaded file can still bundle several physical sheets'
// worth of labour records, so this stays one-to-many.
model DayWorksSheet {
  id              String   @id @default(cuid())
  variationItemId String
  fileName        String
  storageKey      String
  contentType     String?
  createdAt       DateTime @default(now())

  variationItem   VariationItem         @relation(fields: [variationItemId], references: [id])
  materials       DayWorksMaterial[]
  plant           DayWorksPlant[]
  sheetRecords    DayWorksSheetRecord[]
  externalActions ExternalAction[]
}

// One row = one physical day works sheet's SUMMARY, not a per-worker
// breakdown — per-worker/rate-tier extraction was replaced by this
// simpler per-sheet summary after pilot testing found the tiered version
// too much OCR risk/friction. ratePerHour is plain manual entry, no
// rate-type/tier selection (lib/day-works-rates.ts's tiered-rate logic
// and its own local DayWorksRateType — no longer a Prisma enum, since
// nothing here references it — are deliberately left in place, unused;
// the product roadmap intends to reintroduce automatic rate selection
// later once this simpler version has proven itself with real pilot
// users). total (totalHours * ratePerHour) is computed live wherever
// displayed, not stored — matches DayWorksMaterial's quantity*unitCost
// pattern — and simply isn't shown when either is blank, never a false
// $0. Every field below sheetNumber/teamLeaderCount/teamMemberCount is
// optional — this is a deliberately low-friction review step (see this
// model's task notes), not a form with required fields.
//
// Relates directly to VariationItem (variationItemId, required) — same
// independence pattern as DayWorksMaterial/DayWorksPlant (Labour, Plant &
// Material AI Extraction, then extended to Labour itself once the same
// upload-required asymmetry showed up here too). dayWorksSheetId is a
// NULLABLE historical/traceability reference: set for AI-extracted
// records (so they keep their link back to the source file for the
// existing "Re-extract"/"Edit summary" actions, and are fully replaced
// on every re-save from that review UI, matching the previous per-worker
// model's "editable draft list" pattern), null for manually-entered
// records with no file behind them. onDelete: SetNull, not Cascade —
// deleting the sheet must not delete a record that's independent of it.
model DayWorksSheetRecord {
  id              String    @id @default(cuid())
  variationItemId String
  dayWorksSheetId String?
  sheetNumber     String
  teamLeaderCount Int
  teamMemberCount Int
  totalHours      Decimal?  @db.Decimal(6, 2)
  ratePerHour     Decimal?  @db.Decimal(10, 2)
  date            DateTime?
  startTime       String?
  finishTime      String?
  task            String?
  notes           String?
  weather         String?
  location        String?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())

  variationItem VariationItem  @relation(fields: [variationItemId], references: [id])
  dayWorksSheet DayWorksSheet? @relation(fields: [dayWorksSheetId], references: [id], onDelete: SetNull)

  @@index([variationItemId])
}

// One line item = one material bought for the day's work. No markup
// field — deliberately out of scope, this records raw cost only (see
// task rules). Relates directly to the VariationItem (Labour, Plant &
// Material AI Extraction feature) — a materials invoice usually isn't
// tied to one particular labour sheet, so this is independent of any
// specific DayWorksSheet. dayWorksSheetId is kept as a NULLABLE
// historical reference only, for rows that predate this change (backfilled
// from their original sheet) or that a user still chooses to log against
// a specific sheet — never required, never read by cost/total logic
// (see lib/variation-package.ts). onDelete: SetNull, not Cascade — a
// material line item is no longer scoped to its sheet's lifecycle, so
// deleting the sheet must not delete it.
model DayWorksMaterial {
  id               String   @id @default(cuid())
  variationItemId  String
  dayWorksSheetId  String?
  description      String
  quantity         Decimal  @db.Decimal(10, 2)
  unit             String
  unitCost         Decimal  @db.Decimal(10, 2)
  // Optional receipt/photo attachment — same fileName/storageKey/
  // contentType shape as VariationPhoto (Task: reuse the existing
  // photo-attachment pattern), but nullable and singular rather than a
  // one-to-many relation, since this is one optional receipt per line
  // item, not a photo gallery.
  photoFileName    String?
  photoStorageKey  String?
  photoContentType String?
  createdAt        DateTime @default(now())

  variationItem VariationItem  @relation(fields: [variationItemId], references: [id])
  dayWorksSheet DayWorksSheet? @relation(fields: [dayWorksSheetId], references: [id], onDelete: SetNull)

  @@index([variationItemId])
}

// Structurally identical to DayWorksMaterial (description/quantity/unit/
// unitCost/optional photo, same VariationItem-direct + nullable-sheet-
// reference shape) — deliberately its own model rather than a "kind"
// discriminator on DayWorksMaterial, since Plant does NOT receive
// materialsMarkupPercent (Task 1.1: markup stays scoped to Materials only
// — flagged in this session's report as a deliberate assumption the app
// owner may want to revisit with a separate configurable plant markup
// rate later). Keeping them as separate models makes that scoping
// impossible to blur by accident in the total-calculation code.
model DayWorksPlant {
  id               String   @id @default(cuid())
  variationItemId  String
  dayWorksSheetId  String?
  description      String
  quantity         Decimal  @db.Decimal(10, 2)
  unit             String
  unitCost         Decimal  @db.Decimal(10, 2)
  photoFileName    String?
  photoStorageKey  String?
  photoContentType String?
  createdAt        DateTime @default(now())

  variationItem VariationItem  @relation(fields: [variationItemId], references: [id])
  dayWorksSheet DayWorksSheet? @relation(fields: [dayWorksSheetId], references: [id], onDelete: SetNull)

  @@index([variationItemId])
}

model VariationPhoto {
  id                  String   @id @default(cuid())
  variationItemId     String
  fileName            String
  storageKey          String
  contentType         String
  // Same "small generated display copy, original untouched" pattern as
  // UpdateAttachment.thumbnailStorageKey — see lib/image-thumbnails.ts.
  thumbnailStorageKey String?
  createdAt           DateTime @default(now())

  variationItem VariationItem @relation(fields: [variationItemId], references: [id])
}

// An immutable snapshot generated from everything currently attached to a
// VariationItem (photos, correspondence, Day Works Sheets) at the moment
// of generation — the PDF itself and the totals below are both frozen
// here and never recomputed in place. If underlying evidence changes
// afterward, the user generates a NEW VariationPackage row (and a new
// PDF) rather than this one being mutated — a package that's potentially
// already been sent to a Main Contractor must stay a stable record of
// what was actually claimed at that time. A VariationItem can accumulate
// many of these over time as evidence grows.
//
// The five totals are stored as real columns (not just baked into the
// PDF) specifically so a future Payment Claims module can aggregate them
// across many variations without re-parsing any PDF — this is the
// designed reuse point called out in this feature's task notes.
model VariationPackage {
  id                   String   @id @default(cuid())
  variationItemId      String
  generatedByUserId    String
  fileName             String
  storageKey           String
  labourTotal          Decimal  @db.Decimal(12, 2)
  materialsTotal       Decimal  @db.Decimal(12, 2)
  materialsMarkupTotal Decimal  @db.Decimal(12, 2)
  plantTotal           Decimal  @db.Decimal(12, 2)
  grandTotal           Decimal  @db.Decimal(12, 2)
  photoCount           Int
  correspondenceCount  Int
  dayWorksSheetCount   Int
  // Which of PACKAGE_CATEGORIES (lib/variation-package.ts) were included
  // in THIS specific generation — per-generation only, never changes what
  // evidence is actually attached to the item. Existing rows predate this
  // feature and are backfilled to the full category list, since every
  // category was unconditionally included before this existed (see this
  // migration's backfill UPDATE) — an empty array here would wrongly read
  // as "nothing was included."
  includedCategories   String[] @default([])
  // Set when this package was generated by the scheduling automation
  // (lib/variation-schedule.ts) rather than a person clicking Generate —
  // ties it back to the cycle that produced it, so the send step (at
  // scheduledSendAt, if not cancelled) knows exactly which already-
  // generated packages to send without regenerating them.
  scheduleRunId        String?
  createdAt            DateTime @default(now())

  variationItem   VariationItem         @relation(fields: [variationItemId], references: [id])
  generatedBy     User                  @relation(fields: [generatedByUserId], references: [id])
  scheduleRun     VariationScheduleRun? @relation(fields: [scheduleRunId], references: [id])
  externalActions ExternalAction[]
}

model Correspondence {
  id                           String               @id @default(cuid())
  projectId                    String
  variationItemId              String?
  title                        String
  fileName                     String?
  storageKey                   String?
  source                       CorrespondenceSource @default(upload)
  inboundEmailId               String?              @unique
  // Set when this row records an Insurance certificate being sent to the
  // project — references the certificate rather than duplicating its file
  // (see InsuranceCertificate). fileName/storageKey stay null on these rows.
  sourceInsuranceCertificateId String?
  createdAt                    DateTime             @default(now())

  // AI-drafted response letter rows (source: response_letter_draft): the
  // letter text lives here directly (as well as being saved as a .txt file
  // via fileName/storageKey, for the existing download route) so it can be
  // shown/copied inline without re-fetching from S3, matching how inbound
  // email bodies are already displayed.
  bodyText               String?
  addressedToContactId   String?
  sourceContractReviewId String?
  // JSON array of the ContractDeviation ids this letter addresses.
  sourceDeviationIds     Json?

  // Outcome logging (Task 3.4) — a note, and/or a revised contract re-upload
  // that becomes this Main Contractor's new "most recent contract" for the
  // comparison chain (see lib/contract-comparison.ts).
  outcomeNote               String?
  outcomeContractDocumentId String?

  // Set on source: external_update rows — the Update this correspondence
  // entry logs the sending of (see app/api/projects/[projectId]/updates/route.ts).
  sourceUpdateId String?

  // Free-text classification (e.g. "Variation", "Programme change", "General
  // reference") — set on source: inbound_email rows from the human-confirmed
  // type chosen when filing an Incoming Email (see lib/inbound-email-types.ts).
  // Not a locked enum, and searchable via the Correspondence search box.
  category String?

  // Set on source: inbound_email rows filed as a QA record (Task 4) — the
  // QARecord created alongside this Correspondence row, same "resolve an id,
  // then create the Correspondence row with it" pattern as variationItemId.
  qaRecordId String?

  // Set on source: external_action rows — the request this Correspondence
  // entry logs. Created when the request is sent (bodyText = the message
  // sent) and updated in place once a response comes in, so the whole
  // request-and-response exchange lives as ONE evidence-trail entry rather
  // than two (see lib/external-action.ts).
  sourceExternalActionId String? @unique

  project                    Project                @relation(fields: [projectId], references: [id])
  variationItem              VariationItem?         @relation(fields: [variationItemId], references: [id])
  qaRecord                   QARecord?              @relation(fields: [qaRecordId], references: [id])
  inboundEmail               InboundEmail?          @relation(fields: [inboundEmailId], references: [id])
  sourceInsuranceCertificate InsuranceCertificate?  @relation(fields: [sourceInsuranceCertificateId], references: [id])
  addressedToContact         MainContractorContact? @relation(fields: [addressedToContactId], references: [id])
  sourceContractReview       ContractReview?        @relation(fields: [sourceContractReviewId], references: [id])
  outcomeContractDocument    ContractDocument?      @relation(fields: [outcomeContractDocumentId], references: [id])
  sourceUpdate               Update?                @relation(fields: [sourceUpdateId], references: [id])
  sourceExternalAction       ExternalAction?        @relation(fields: [sourceExternalActionId], references: [id])
}

model SafetyDocument {
  id                String             @id @default(cuid())
  projectId         String
  title             String
  // Defaults to `other` — see SafetyDocumentType comment (Task 1.1).
  type              SafetyDocumentType @default(other)
  notes             String?
  fileName          String?
  storageKey        String?
  expiresAt         DateTime?
  // Last deadline-reminder stage sent for this document's expiresAt — see ReminderStage.
  lastReminderStage ReminderStage?
  createdAt         DateTime           @default(now())

  project Project @relation(fields: [projectId], references: [id])
}

// Quality Assurance sign-offs (Task 2). Assigned to EITHER the project
// directly (job-level QA, "part of the contracted works") OR a specific
// SI/Variation via variationItemId — never both, mirroring how
// Correspondence already models "always has a project, optionally also
// tied to one item" (see Correspondence.variationItemId above). `stage` is
// deliberately free text, not an enum — QA checkpoints vary enormously by
// trade, unlike SafetyDocumentType's more universal categories.
model QARecord {
  id              String   @id @default(cuid())
  projectId       String
  variationItemId String?
  stage           String
  notes           String?
  date            DateTime @default(now())
  createdAt       DateTime @default(now())

  project        Project              @relation(fields: [projectId], references: [id])
  variationItem  VariationItem?       @relation(fields: [variationItemId], references: [id])
  correspondence Correspondence[]
  attachments    QARecordAttachment[]
  // Updates tagged straight to this record via the "Assign QA" tag option
  // (see Update.qaRecordId) — distinct from `attachments`, which is the
  // file evidence copied in when that tagging happened.
  updates        Update[]
}

// One row per file of evidence on a QARecord — mirrors UpdateAttachment
// exactly (same field shape, same non-destructive copy-on-create story) so
// a single QA record can hold multiple photos, e.g. several angles of the
// same lining before a pour, not just one file.
model QARecordAttachment {
  id                  String   @id @default(cuid())
  qaRecordId          String
  fileName            String
  storageKey          String
  contentType         String?
  thumbnailStorageKey String?
  createdAt           DateTime @default(now())

  qaRecord QARecord @relation(fields: [qaRecordId], references: [id])
}

// A request for an external (no-login) recipient to Acknowledge, Approve,
// Sign, Confirm, Reject, or Comment on a specific SI/Variation or Day
// Works Sheet — exactly one of variationItemId/dayWorksSheetId is set,
// enforced at the application level (see lib/external-action.ts), not a DB
// constraint, same convention as QARecord's project-vs-item exclusivity.
//
// IMPORTANT — honest labelling: "sign" records a typed name + explicit
// checkbox + timestamp. It is NOT a certified/legally-binding electronic
// signature and must never be described as one anywhere in the app —
// only ever as a "recorded acknowledgement".
//
// tokenHash follows the exact same pattern as PasswordResetToken (see
// lib/password-reset.ts): a 32-byte random value is generated, only its
// SHA-256 hash is ever stored, and the raw value lives only in the emailed
// link — this table can never itself leak a usable token.
model ExternalAction {
  id                 String               @id @default(cuid())
  projectId          String
  variationItemId    String?
  dayWorksSheetId    String?
  // Set TOGETHER WITH variationItemId (never with dayWorksSheetId) when
  // this is a Request Approval for a specific generated VariationPackage
  // rather than a generic approve/sign/confirm/reject on the item's live
  // state — see VariationPackageSection's "Request Approval" and
  // lib/external-action.ts's computeValueSnapshot. Approving a package
  // means approving exactly what's IN that frozen PDF, so its own stored
  // totals are used, never the item's current (possibly since-changed)
  // live totals.
  variationPackageId String?
  // Set ALONE (never with variationItemId/dayWorksSheetId/
  // variationPackageId) when this is a Request Approval for a live
  // "Hours on Site" sheet — see lib/external-action.ts's
  // computeValueSnapshot and submitExternalActionResponse, which flips
  // HoursOnSiteSheet.approvedAt on a responseChoice of "approved". The
  // sheet's own optional variationItemId (if it was linked to a Site
  // Instruction) is carried through into valueSnapshot/sourceLabel but is
  // NOT set as this row's own variationItemId — the target here is
  // unambiguously the sheet, not the SI.
  hoursOnSiteSheetId String?
  type               ExternalActionType
  // Customisable context/message shown to the recipient on the public
  // response page — set at send time, not required.
  message            String?
  // Frozen breakdown of recorded Day Works / labour / materials / plant
  // value at SEND time, for approve/sign/confirm/reject requests only (see
  // lib/external-action.ts's computeValueSnapshot) — shown alongside the
  // drafted message as the primary "what's actually being asked" content
  // on the public response page, instead of just the source record's own
  // description (a real, confirmed bug — a Main Contractor being shown
  // their own instruction text back and asked to "approve" it is
  // meaningless). Frozen rather than recomputed at view time so the
  // approval always reflects the figure actually sent, even if more Day
  // Works gets logged against the item afterward. Null for
  // acknowledge/comment requests, which carry no such ask.
  valueSnapshot      Json?
  tokenHash          String               @unique
  expiresAt          DateTime
  status             ExternalActionStatus @default(pending)

  // Recipient — same saved-contact-or-one-off-email pattern as External
  // Updates (lib/external-update.ts): a saved contact's email is always
  // re-resolved to its CURRENT value at send time, never trusted from the
  // client, so mainContractorContactId is kept for that resolution/audit
  // trail even though recipientEmail is what the message actually went to.
  mainContractorContactId String?
  recipientEmail          String
  recipientName           String?
  // FYI-only email cc list, frozen at send time — same "frozen at send,
  // not recomputed" rule as valueSnapshot. Cc recipients see the same
  // message as an ordinary email cc; they never get their own actionable
  // response link (there is exactly one tokenHash/response per action).
  // Only ever populated by the scheduling automation's distribution list
  // (lib/variation-schedule.ts) — the manual Request Approval dialogs
  // don't expose a cc field.
  ccEmails                String[] @default([])

  sentByUserId String
  sentAt       DateTime @default(now())

  // Response fields directly on this row (Task 1.2's "use judgement") —
  // a separate ExternalActionResponse table would only ever hold a single
  // 1:1 row per action, so it doesn't earn its own model. All null until
  // responded.
  responseChoice  ExternalActionChoice?
  // Self-attested by the recipient on the public page — there is no
  // identity verification, consistent with this being a recorded
  // acknowledgement, not a certified signature.
  responseName    String?
  responseComment String?
  respondedAt     DateTime?

  project                  Project                @relation(fields: [projectId], references: [id])
  variationItem            VariationItem?         @relation(fields: [variationItemId], references: [id])
  dayWorksSheet            DayWorksSheet?         @relation(fields: [dayWorksSheetId], references: [id])
  variationPackage         VariationPackage?      @relation(fields: [variationPackageId], references: [id])
  hoursOnSiteSheet         HoursOnSiteSheet?      @relation("HoursOnSiteSheetExternalActions", fields: [hoursOnSiteSheetId], references: [id])
  mainContractorContact    MainContractorContact? @relation(fields: [mainContractorContactId], references: [id])
  sentByUser               User                   @relation(fields: [sentByUserId], references: [id])
  correspondence           Correspondence?
  approvedHoursOnSiteSheet HoursOnSiteSheet?      @relation("HoursOnSiteSheetApprovedBy")
}

// Sliding-window throttle for the public token-lookup/response route —
// same DB-row-count pattern as lib/login-rate-limit.ts, keyed by source IP
// rather than email since there's no email being submitted at lookup time
// (the attacker-controlled input here is the token guess itself). Only
// FAILED lookups are recorded (see lib/external-action.ts), so a
// legitimate recipient opening their own valid link never spends this
// budget — it exists purely to slow down someone trying many token
// guesses, on top of the 256-bit token space already making that
// computationally infeasible on its own.
model ExternalActionLookupAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dhKey String
  authKey   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model UpdateAttachment {
  id                  String   @id @default(cuid())
  updateId            String
  fileName            String
  storageKey          String
  contentType         String
  // A small (~800px, JPEG) display copy generated at upload time for
  // image attachments only — see lib/image-thumbnails.ts. Null for non-
  // image attachments (PDF/DOCX never get one) and for any attachment
  // uploaded before this field existed; the file route falls back to
  // serving the original itself whenever this is unset, so nothing ever
  // breaks, it just isn't lightweight yet. The original storageKey above
  // is never touched by this — full quality, always.
  thumbnailStorageKey String?
  createdAt           DateTime @default(now())

  update Update @relation(fields: [updateId], references: [id])
}

// One row per AI (Grok) call, written by lib/ai-usage.ts — the single place
// every lib/grok.ts function and lib/transcription.ts's STT call reports
// through, so cost math and logging never gets duplicated per call site.
// Deliberately has NO relations (plain String org/user ids, no @relation) —
// this is a durable, append-only cost ledger that must keep every row even
// if the referenced org/user/project is later deleted, and must never be
// blocked by an FK constraint from a fire-and-forget background job whose
// org/user context is genuinely unknown (e.g. the inbound-email webhook).
// feature is a plain string, not an enum, matching this codebase's existing
// "extensible preset list" convention (see lib/trades.ts, TRADE_PRESETS) —
// new AI features shouldn't need a migration to start logging.
model AiUsageLog {
  id               String   @id @default(cuid())
  feature          String
  organisationId   String?
  userId           String?
  model            String
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  // Computed from ACTUAL promptTokens/completionTokens returned by the Grok
  // response against the AiModelPricing row for `model` at call time — never
  // a flat per-feature estimate. Null when a call fails before usage is
  // known, or when a matching pricing row doesn't exist.
  costUsd          Decimal? @db.Decimal(10, 6)
  success          Boolean
  errorMessage     String?
  // Optional, cheap trace-back to whatever triggered this specific call
  // (e.g. a contractReviewId, documentId, or inboundEmailId) — deliberately
  // just a free-text label, not a relation, per the "don't over-engineer
  // this" instruction; only meant for spotting an outlier and knowing where
  // to look, not for joining.
  contextRef       String?
  createdAt        DateTime @default(now())

  @@index([feature, createdAt])
  @@index([organisationId, createdAt])
}

// Configurable per-model $/token pricing, so a rate change (xAI repricing,
// or switching GROK_MODEL to a different tier) never requires a code
// change — lib/ai-usage.ts looks up the row matching the model string used
// for a given call. Single current rate per model, no historical
// effective-dating: a rate change going forward is fine to apply from the
// moment it's edited, since this dashboard is for cost/usage trend-spotting,
// not for reproducing an exact historical invoice.
model AiModelPricing {
  id                    String   @id @default(cuid())
  model                 String   @unique
  inputPricePerMillion  Decimal  @db.Decimal(10, 4)
  outputPricePerMillion Decimal  @db.Decimal(10, 4)
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())
}

// A subcontractor's own crew, reusable across every one of its projects —
// mirrors MainContractorContact's own "saved, searchable, reused" role, but
// for the subbie's own workers rather than the main contractor's people.
// Deliberately minimal (a name, nothing else) — this is a type-ahead list
// for the Hours on Site feature below, not a staff-management/HR screen
// (no role, no rate, no employment details; see that feature's own scope
// note for what's explicitly excluded).
model Worker {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  createdAt      DateTime @default(now())

  organisation Organisation        @relation(fields: [organisationId], references: [id])
  sheetLinks   HoursOnSiteWorker[]

  @@unique([organisationId, name])
}

// "Hours on Site" — a live start/finish capture of labour hours, distinct
// from the existing DayWorksSheet (which is a photographed PAPER sheet,
// read after the fact by AI). This is the on-site, in-the-moment capture
// path: tap Start, work, tap Finish, get an editable sheet naming the
// actual workers involved. Both paths produce the same kind of evidence
// (supports a variation claim) but via different mechanisms, so this is
// its own model rather than forcing DayWorksSheet's required
// variationItemId/photographed-sheet shape to also cover a live timer with
// an OPTIONAL SI link and free-text comments.
//
// totalHours is independently editable from the startedAt/finishedAt
// delta — set from that delta the moment Finish is tapped, then never
// recomputed automatically again, so a manual correction (a missed lunch
// deduction, a forgotten start) always sticks. Hours must remain editable
// indefinitely — see lib/hours-on-site.ts.
model HoursOnSiteSheet {
  id              String    @id @default(cuid())
  projectId       String
  // Optional — set only when a Site Instruction was selected; otherwise
  // `comments` carries the free-text description of the work instead.
  variationItemId String?
  comments        String?
  startedAt       DateTime
  finishedAt      DateTime?
  totalHours      Decimal?  @db.Decimal(6, 2)
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Set once a Site Manager (or other project contact) approves the sheet
  // via its secure ExternalAction link — see lib/external-action.ts's
  // submitExternalActionResponse. Once approvedAt is set, hours/workers/
  // comments become read-only (see lib/hours-on-site.ts) — approval is a
  // one-way gate, matching "ready for inclusion in a variation claim" as
  // commercial evidence. approvedByExternalActionId points at the specific
  // ExternalAction whose response caused the approval, for audit; the
  // recipient's self-attested name is copied onto approvedByName since
  // there's no login identity to attribute it to.
  approvedAt                 DateTime?
  approvedByName             String?
  approvedByExternalActionId String?   @unique
  // Set only when approval happened by handing the device straight to the
  // Site Manager/foreman to sign there and then (see lib/hours-on-site.ts's
  // signSheetOnDevice) — an ALTERNATIVE route to approval alongside the
  // secure-link ExternalAction above, not a second lock: both routes set
  // approvedAt/approvedByName identically, this just additionally has a
  // drawn signature image to show. Null for a link-approved sheet (no
  // device was ever handed over, so there's no signature to draw).
  signatureImageStorageKey   String?
  // Unique, permanent reference number for this sheet — printed on the
  // PDF exactly like a pre-numbered paper dayworks pad (see the DWS 01/02
  // reference templates in docs/Standard Documents). A plain Postgres-
  // backed autoincrement: globally unique and gap-free-under-concurrency
  // by construction, so no custom counter/transaction logic is needed.
  // Deliberately global rather than per-organisation — see
  // lib/hours-on-site.ts's startSheet comment.
  dayWorksSheetNumber        Int       @unique @default(autoincrement())

  project          Project             @relation(fields: [projectId], references: [id])
  variationItem    VariationItem?      @relation(fields: [variationItemId], references: [id])
  createdByUser    User                @relation(fields: [createdByUserId], references: [id])
  workers          HoursOnSiteWorker[]
  externalActions  ExternalAction[]    @relation("HoursOnSiteSheetExternalActions")
  approvedByAction ExternalAction?     @relation("HoursOnSiteSheetApprovedBy", fields: [approvedByExternalActionId], references: [id])
}

// One row per worker named on a sheet — plain join, no per-worker hours of
// its own (this is a headcount/evidence list, "who was there," not a
// payroll timesheet apportioning hours per person; see the feature's own
// explicit scope exclusions).
model HoursOnSiteWorker {
  id       String @id @default(cuid())
  sheetId  String
  workerId String

  sheet  HoursOnSiteSheet @relation(fields: [sheetId], references: [id])
  worker Worker           @relation(fields: [workerId], references: [id])

  @@unique([sheetId, workerId])
}
