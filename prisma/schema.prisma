// Lands via the SendGrid Inbound Parse webhook (lib/inbound-email.ts),
// addressed to inbox+<organisationId>@<inbound domain> — organisationId is
// always known immediately (parsed from the address), but projectId is not:
// nothing is pre-known from which address an email arrived at, so it starts
// null and is only ever set once a human confirms it in the Incoming Emails
// review queue (see app/(app)/incoming-emails/page.tsx). suggested* fields
// are Grok's best guess, shown for review — never auto-applied.
model InboundEmail {
  id             String             @id @default(cuid())
  organisationId String
  projectId      String?
  sender         String
  ccAddresses    String[]           @default([])
  subject        String
  body           String
  status         InboundEmailStatus @default(pending_review)
  receivedAt     DateTime           @default(now())

  // AI suggestions — advisory only, a human confirms or overrides every one
  // of these before anything gets filed (see Incoming Emails review dialog).
  suggestedProjectId         String?
  suggestedProjectConfidence Float?
  // Free text, not a locked enum — see lib/inbound-email-types.ts for the
  // common presets offered in the UI; any custom string is also valid.
  suggestedType              String?
  suggestedVariationItemId   String?
  aiSummary                  String?
  // Set when classifyAndSuggest (lib/inbound-email.ts) throws — a short,
  // human-readable reason, surfaced in the Incoming Emails UI so a failed
  // classification is visibly distinct from "AI genuinely found nothing"
  // rather than silently leaving the row blank either way. Cleared on a
  // successful (re)classification.
  classificationError        String?

  reviewedByUserId String?
  reviewedAt       DateTime?
  dismissedAt      DateTime?

  organisation           Organisation             @relation(fields: [organisationId], references: [id])
  project                Project?                 @relation("InboundEmailProject", fields: [projectId], references: [id])
  suggestedProject       Project?                 @relation("InboundEmailSuggestedProject", fields: [suggestedProjectId], references: [id])
  suggestedVariationItem VariationItem?           @relation("InboundEmailSuggestedVariationItem", fields: [suggestedVariationItemId], references: [id])
  attachments            InboundEmailAttachment[]
  evidence               Evidence[]
  correspondence         Correspondence?
}

model InboundEmailAttachment {
  id             String   @id @default(cuid())
  inboundEmailId String
  fileName       String
  storageKey     String
  contentType    String
  createdAt      DateTime @default(now())

  inboundEmail InboundEmail @relation(fields: [inboundEmailId], references: [id])
}

model EvidenceScopeItem {
  id          String @id @default(cuid())
  evidenceId  String
  scopeItemId String

  evidence  Evidence  @relation(fields: [evidenceId], references: [id])
  scopeItem ScopeItem @relation(fields: [scopeItemId], references: [id])

  @@unique([evidenceId, scopeItemId])
}

model EvidenceProgrammeItem {
  id              String @id @default(cuid())
  evidenceId      String
  programmeItemId String

  evidence      Evidence      @relation(fields: [evidenceId], references: [id])
  programmeItem ProgrammeItem @relation(fields: [programmeItemId], references: [id])

