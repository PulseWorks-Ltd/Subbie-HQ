{
  "name": "subbie-hq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:staging": "dotenv -e .env.staging -- next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:staging:migrate": "node scripts/with-staging-db.js prisma migrate dev",
    "db:staging:studio": "node scripts/with-staging-db.js prisma studio",
    "db:staging:reset": "node scripts/with-staging-db.js prisma migrate reset --force",
    "db:staging:wipe-projects": "node scripts/with-staging-db.js node scripts/wipe-projects.mjs",
    "db:prod:migrate:deploy": "node scripts/check-db-target.js migrate deploy && prisma migrate deploy",
    "db:prod:wipe-projects": "node scripts/check-db-target.js wipe-projects && node scripts/wipe-projects.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@napi-rs/canvas": "^1.0.3",
    "@prisma/client": "^5.20.0",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/nextjs": "^10.69.0",
    "bcryptjs": "^3.0.3",
    "next": "^14.2.35",
    "next-auth": "5.0.0-beta.32",
    "openai": "^6.49.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "^0.35.3",
    "stripe": "^22.4.0",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "25.2.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.10",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.5.4",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "postcss": "^8.5.23",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.4"
  }
}
