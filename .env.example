DATABASE_URL="postgresql://postgres:postgres@localhost:5432/subbiehq"

# Staging Postgres — a separate Railway service from production. Safe to wipe
# and reset freely. Used only by the db:staging:* / dev:staging npm scripts,
# never picked up automatically by a plain `npm run dev`. See docs/staging.md.
STAGING_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/subbiehq_staging"

# Set to "staging" only inside .env.staging (used by npm run dev:staging).
# Leave unset here — it's what drives the on-screen "STAGING" banner and the
# server startup log line, so it must never be true against production.
APP_DB_ENV=""

# Comma-separated host:port of the REAL production Postgres (the host:port
# segment of production's DATABASE_URL — include the port: on Railway's TCP
# proxy, many unrelated services share the same hostname and differ only by
# port). Required before any db:prod:* script will run at all — see
# docs/staging.md. Leave blank on developer machines; only set this where a
# production migration is being run deliberately.
PROD_DB_HOST_ALLOWLIST=""

# Shared secret the Railway Cron Job sends to authenticate calls to
# /api/cron/reminders. Generate with: openssl rand -base64 32
CRON_SECRET="generate-with-openssl-rand-base64-32"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

S3_REGION="ap-southeast-2"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_BUCKET="your-bucket-name"

XAI_API_KEY="your-xai-api-key"

VAPID_PUBLIC_KEY="generate-with-npx-web-push-generate-vapid-keys"
VAPID_PRIVATE_KEY="generate-with-npx-web-push-generate-vapid-keys"
VAPID_SUBJECT="mailto:you@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="same-value-as-VAPID_PUBLIC_KEY"

SENDGRID_API_KEY="your-sendgrid-api-key"
SENDGRID_FROM_EMAIL="you@yourdomain.com"
SENDGRID_REPLY_TEMPLATE_ID="d-your-dynamic-template-id"
SENDGRID_INVITE_TEMPLATE_ID="d-your-dynamic-template-id"

# Incoming Emails (SendGrid Inbound Parse) — requires an MX record for this
# exact subdomain pointed at mx.sendgrid.net (10), configured as an "Inbound
# Parse" webhook in SendGrid pointed at
# https://<your-app-url>/api/webhooks/inbound-email?token=<INBOUND_EMAIL_WEBHOOK_SECRET>.
# Each Organisation gets its own address via a "+" tag on this one domain:
# inbox+<organisationId>@<INBOUND_EMAIL_DOMAIN> — see lib/inbound-email.ts.
INBOUND_EMAIL_DOMAIN="mail-in.yourdomain.com"
INBOUND_EMAIL_WEBHOOK_SECRET="generate-with-openssl-rand-base64-32"
